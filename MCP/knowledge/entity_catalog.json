  "behavior_glossary": {
    "patrol_walker": "Walks back and forth, reverses at walls/edges",
    "flyer": "Flies in arc patterns through air",
    "flyer_aggressive": "Flies directly toward Wario",
    "flyer_phasing": "Can fly through walls and solid tiles",
    "stationary_hazard": "Does not move, damages on contact",
    "stationary_shooter": "Stationary, fires projectiles at intervals",
    "triggered_dropper": "Drops when Wario is nearby",
    "triggered_spawn": "Appears when Wario enters trigger zone",
    "triggered_attack": "Stationary until Wario in range, then attacks",
    "burrower": "Hides in ground/walls/water, emerges to attack",
    "roller": "Rolls along ground, bounces off walls",
    "crusher": "Moves linearly, crushes Wario causing W_TUBURE",
    "explosive": "Explodes on contact or after timer",
    "teleport": "Warps Wario to paired destination",
    "tilt_platform": "Tilts when Wario stands on one side",
    "swing_platform": "Swings on rope, Wario can ride it",
    "domino_chain": "Falls in sequence when first block triggered",
    "domino_trigger": "Initiates domino chain",
    "domino_end": "Marks end of domino chain",
    "domino_standard": "Standard domino block",
    "domino_piece": "Individual domino block piece",
    "pinball": "Physics-based pinball in machine area",
    "pinball_entry": "Spawns pinball into playfield",
    "pinball_bumper": "Bounces pinball on contact",
    "pinball_hazard": "Damages in pinball area",
    "boss": "Multi-part boss with attack phases",
    "boss_door_part": "Part of multi-component boss door",
    "expanding": "Periodically expands and contracts",
    "pouncer": "Jumps toward Wario from stationary position",
    "kickable": "Can be kicked by Wario's attacks",
    "ground_pounder": "Slams ground creating shockwaves",
    "water_patrol": "Swims in water along set path",
    "extending": "Extends spiked arm toward Wario",
    "periodic_hazard": "Activates on timer, damaging during active phases",
    "stationary_structure": "Multi-block structure, destroyed block by block",
    "vertical_mover": "Moves up and down on fixed path",
    "horizontal_mover": "Moves left and right on fixed path",
    "floater": "Floats upward, pops when attacked",
    "none": "No behavior — placeholder or utility entity"
  },

  "wario_forms_caused_by_entities": {
    "W_FIRE": "Fire tiles (YFIRE), fire enemy attacks. Runs fast, destroys fire blocks.",
    "W_DEBU": "Fat enemy (Deburina). Slow but heavy, screen-shaking ground pound.",
    "W_ZOMBI": "Ghost (Yurei), Corpse (Shitain), darkness tiles. Slow, pass through zombie walls. Vulnerable to light.",
    "W_SNOW": "Snowman (Yeti), Falling Snow. Rolling snowball, breaks snow blocks.",
    "W_BAT": "Bat (koumori). Free flight in all directions.",
    "W_TUBURE": "Flattening Hammer, Triangle Toy Block. Flat paper form, slips through 1-tile gaps."
  }
}
